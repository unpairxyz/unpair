# Build-time settings for the Unpair app. Copy to .env.
# Optional 1Click partner key. Without it 1Click uses its public fee schedule.
VITE_ONECLICK_JWT=
# Who receives the routing fee and how much. Cap is 100 bps in code. 0 for none.
VITE_FEE_RECIPIENT=unpair.near
VITE_FEE_BPS=50
# unpair-api for screening and signed quotes. Leave empty to call 1Click directly.
VITE_API_URL=
# Pinned Ed25519 public key of that API, hex. Quotes that do not verify are refused.
VITE_API_PUBKEY=
