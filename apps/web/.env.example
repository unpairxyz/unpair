# All values are public. They end up in the static bundle.
# Partner JWT from https://partners.near-intents.org. Optional.
VITE_ONECLICK_JWT=
# NEAR account or EVM-style address that receives the routing fee.
VITE_FEE_RECIPIENT=unpair.near
# Routing fee in basis points. Capped at 100 in the SDK.
VITE_FEE_BPS=50
# Official domain shown in the clone-site notice.
VITE_OFFICIAL_ORIGIN=https://unpair.xyz
# unpair-api. Optional. When set, addresses are screened there first and
# quotes come back signed. Pin the API's public key from GET /v1/pubkey.
VITE_API_URL=
VITE_API_PUBKEY=
# gRPC-web proxy in front of lightwalletd. Optional. When set, the page offers
# "This browser": a Zcash wallet that runs inside the page for one swap.
VITE_LWD_GRPC_WEB_URL=
# main or test. The network that wallet uses.
VITE_ZCASH_NETWORK=main
