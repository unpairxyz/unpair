[Unit]
Description=Unpair API
After=network-online.target
Wants=network-online.target

[Service]
User=unpair
Group=unpair
EnvironmentFile=/etc/unpair/api.env
ExecStart=/usr/local/bin/unpair-api
WorkingDirectory=/var/lib/unpair
Restart=on-failure
RestartSec=5
CPUWeight=50
# 256M is enough without hosted swaps. Proving for hosted swaps needs 768M.
MemoryMax=768M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/unpair
ReadWritePaths=/var/lib/unpair
# The wallet database holds the full viewing key: new files are private to the service user.
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
TasksMax=256

[Install]
WantedBy=multi-user.target
