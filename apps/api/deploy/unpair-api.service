[Unit]
Description=Unpair API
After=network-online.target
Wants=network-online.target

[Service]
User=unpair
Group=unpair
EnvironmentFile=/etc/unpair/api.env
ExecStart=/usr/local/bin/unpair-api
WorkingDirectory=/var/lib/unpair
Restart=on-failure
RestartSec=5
CPUWeight=50
# 256M is enough without hosted swaps. Proving for hosted swaps needs 768M.
MemoryMax=768M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/unpair
ReadWritePaths=/var/lib/unpair

[Install]
WantedBy=multi-user.target
