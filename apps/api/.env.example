# unpair-api configuration. Copy to .env or set in the systemd unit.

UNPAIR_BIND=127.0.0.1:8787
UNPAIR_ALLOWED_ORIGINS=https://unpair.xyz,http://localhost:5173

# Routing fee. Cap is 100 bps in code.
UNPAIR_FEE_RECIPIENT=unpair.near
UNPAIR_FEE_BPS=50

# 1Click partner key. Optional.
UNPAIR_ONECLICK_JWT=

# Ed25519 seed for signed quotes, 32 bytes hex. Generate once:
#   head -c 32 /dev/urandom | xxd -p -c 64
UNPAIR_SIGNING_SEED=

# Screening: off | denylist | http
UNPAIR_SCREENING=denylist
UNPAIR_SCREENING_DENYLIST=/etc/unpair/denylist.txt
# For http: POST {address, chain}; expect {"allowed": bool, "reason": string}
UNPAIR_SCREENING_URL=
UNPAIR_SCREENING_KEY_HEADER=authorization
UNPAIR_SCREENING_KEY=
UNPAIR_SCREENING_TIMEOUT_MS=4000

# Geofence by edge header. Cloudflare sets cf-ipcountry.
UNPAIR_GEOFENCE=CU,IR,KP,SY
UNPAIR_COUNTRY_HEADER=cf-ipcountry
UNPAIR_GEOFENCE_REQUIRE_HEADER=false

RUST_LOG=info,tower_http=info
